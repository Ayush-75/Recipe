default_platform(:android)

platform :android do

  private_lane :gradle_file_path do
    project_dir = File.expand_path('..', Dir.pwd)
    gradle_file = File.join(project_dir, 'app', 'build.gradle.kts')

    unless File.exist?(gradle_file)
      gradle_file = File.join(Dir.pwd, 'app', 'build.gradle.kts')
    end

    unless File.exist?(gradle_file)
      UI.user_error!("Could not find build.gradle.kts file.")
    end

    gradle_file
  end

  private_lane :increment_version_code do
    gradle_file = gradle_file_path
    s = File.read(gradle_file)
    regex = /versionCode\s*=\s*(\d+)/
    current = s[regex, 1].to_i
    new_code = current + 1
    s.gsub!(regex, "versionCode = #{new_code}")
    File.write(gradle_file, s)
    new_code
  end

  private_lane :increment_version_name do |options|
    gradle_file = gradle_file_path
    bump_type = options[:bump_type]

    s = File.read(gradle_file)
    regex = /versionName\s*=\s*"([\d\.]+)"/
    current = s[regex, 1]

    major, minor, patch = current.split('.').map(&:to_i)

    case bump_type
    when "major"
      major += 1; minor = 0; patch = 0
    when "minor"
      minor += 1; patch = 0
    when "patch"
      patch += 1
    end

    new_version = "#{major}.#{minor}.#{patch}"
    s.gsub!(regex, "versionName = \"#{new_version}\"")
    File.write(gradle_file, s)
    new_version
  end

  desc "Deploy to Google Play"
  lane :deploy_to_play_store do
    bump_patch

    upload_to_play_store(
      track: 'internal',
      aab: Dir["app/build/outputs/bundle/release/*.aab"].last,
      metadata_path: 'fastlane/metadata/android',
      json_key: 'play_config.json'
    )
  end
end